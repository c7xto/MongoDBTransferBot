# Parent/control bot
BOT_TOKEN=123456789:replace_with_parent_bot_token
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_with_api_hash

# Host-owned configuration database
MONGO_URI=mongodb+srv://user:password@example.mongodb.net/
ADMIN_ID=123456789

# Optional host-owned runtime database. Defaults to MONGO_URI.
# Set this when transfer ledgers/checkpoints should use a separate cluster.
STATE_MONGO_URI=mongodb+srv://user:password@example.mongodb.net/
STATE_DB_PREFIX=c7_runtime

# Optional legacy single-user bootstrap values
DB_NAME=
COLLECTION_NAME=
TARGET_CHANNEL=
SPEED_DELAY=3.5

# Required only by /prescan user-account sessions
ENCRYPTION_KEY=

# Hosting provider normally injects this
PORT=8080
